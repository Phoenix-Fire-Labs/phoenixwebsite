# Phoenix Fire Labs website — example environment.
# Copy to .env.local for local development. Never commit real secrets.
# Optional analytics event sink for briefing_request events.
BRIEFING_ANALYTICS_URL=
# Optional CRM fan-out for qualified briefings (email, agency, useCase only).
BRIEFING_CRM_URL=
# Webhook URL receiving qualified briefing JSON (human submissions only).
# Leave unset in local dev; the route returns a 502 with a field error instead of sending.
BRIEFING_INBOX=

# SHA-256 (base64) of the exact HOMEPAGE_JSONLD bytes.
# NOT allowlisted in the CSP today: next.config.ts ships
# script-src 'self' 'unsafe-inline' 'unsafe-eval', and listing any hash makes
# browsers ignore 'unsafe-inline', which Next's hydration needs. Kept for a
# future nonce/hash scheme. Recompute when the structured data changes:
#   node scripts/jsonld-hash.mjs
NEXT_PUBLIC_JSONLD_HASH=RvePd/exhPgez+TaYJQ+2ppv8mTJARL0L3Vjt5YyE6s=

# scrypt PHC string for the preview password. Generate with:
#   printf %s 'your-password' | node scripts/preview-hash.mjs
PREVIEW_PASSWORD_HASH=

# 32+ random bytes, hex-encoded. Rotating revokes every preview session.
PREVIEW_SESSION_SECRET=

# Gate the whole site behind the preview login. Set to "false" at launch.
SITE_PREVIEW_GATED=true
