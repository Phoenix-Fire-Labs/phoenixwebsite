{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,sitemap,robots,opengraph-image,not-found,error}.{ts,tsx}",
    "e2e/**/*.ts",
    "src/**/*.test.ts",
    "scripts/*.mjs",
    "tools/**/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "e2e/**/*.ts",
    "scripts/*.mjs"
  ],
  "ignoreDependencies": [
    "publint",
    "tailwindcss"
  ]
}
